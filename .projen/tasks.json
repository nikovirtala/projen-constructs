{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(pnpm -c exec \"node --print process.env.PATH\")"
  },
  "tasks": {
    "biome": {
      "name": "biome",
      "description": "Runs Biome against the codebase",
      "steps": [
        {
          "execArgs": [
            "biome",
            "check",
            "--no-errors-on-unmatched",
            "--write"
          ],
          "receiveArgs": true
        }
      ]
    },
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "bundle-vitest-define-config": {
      "name": "bundle-vitest-define-config",
      "steps": [
        {
          "exec": "tsx --tsconfig tsconfig.json src/bundle-vitest-define-config.ts"
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "execArgs": [
            "jsii-diff",
            "npm:@nikovirtala/projen-constructs",
            "-k",
            "--ignore-file",
            ".compatignore"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "jsii --silence-warnings=reserved-word"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "tsx --tsconfig test/tsconfig.json .projenrc.ts"
        },
        {
          "spawn": "install:homebrew"
        },
        {
          "spawn": "bundle-vitest-define-config"
        }
      ]
    },
    "docgen": {
      "name": "docgen",
      "description": "Generate API.md from .jsii manifest",
      "steps": [
        {
          "execArgs": [
            "jsii-docgen",
            "-o",
            "API.md"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "homebrew:bundle": {
      "name": "homebrew:bundle",
      "steps": [
        {
          "exec": "command -v brew >/dev/null 2>&1 || eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || /opt/homebrew/bin/brew shellenv 2>/dev/null)\" && brew bundle"
        }
      ],
      "shell": [
        "bash",
        "-c"
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "pnpm i --frozen-lockfile"
        }
      ]
    },
    "install:homebrew": {
      "name": "install:homebrew",
      "steps": [
        {
          "exec": "command -v brew >/dev/null 2>&1 || { NONINTERACTIVE=1 /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" && eval \"$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null || /opt/homebrew/bin/brew shellenv 2>/dev/null)\"; }"
        },
        {
          "spawn": "homebrew:bundle"
        }
      ],
      "shell": [
        "bash",
        "-c"
      ]
    },
    "mise:trust": {
      "name": "mise:trust",
      "steps": [
        {
          "exec": "mise trust"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "spawn": "package:js",
          "condition": "node -e \"if (!process.env.CI) process.exit(1)\""
        },
        {
          "spawn": "package-all",
          "condition": "node -e \"if (process.env.CI) process.exit(1)\""
        }
      ]
    },
    "package-all": {
      "name": "package-all",
      "description": "Packages artifacts for all target languages",
      "steps": [
        {
          "spawn": "package:js"
        }
      ]
    },
    "package:js": {
      "name": "package:js",
      "description": "Create js language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--pack-command",
            "pnpm pack",
            "--target",
            "js"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies",
      "steps": [
        {
          "exec": "pnpm dlx npm-check-updates@18 --upgrade --target=minor --peer --dep=dev,peer --filter=@mrgrain/cdk-esbuild"
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        }
      ]
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "spawn": "biome"
        },
        {
          "exec": "vitest run",
          "receiveArgs": true
        },
        {
          "spawn": "typedoc"
        }
      ]
    },
    "test:update": {
      "name": "test:update",
      "steps": [
        {
          "exec": "vitest --update",
          "receiveArgs": true
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "steps": [
        {
          "exec": "vitest watch",
          "receiveArgs": true
        }
      ]
    },
    "typedoc": {
      "name": "typedoc",
      "description": "Generate TypeDoc documentation",
      "steps": [
        {
          "exec": "typedoc"
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        },
        {
          "exec": "jsii --silence-warnings=reserved-word"
        }
      ]
    },
    "update-versions": {
      "name": "update-versions",
      "description": "fetch latest aws-cdk-lib, node.js and typescript versions from npmjs.com",
      "steps": [
        {
          "exec": "tsx .projen/update-versions.ts"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "pnpm",
            "dlx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@jsii/spec,@mrgrain/cdk-esbuild,esbuild,jsii-diff,jsii-pacmak,projen,tsx,@mrgrain/jsii-struct-builder,case,constructs"
          ]
        },
        {
          "exec": "pnpm i --no-frozen-lockfile"
        },
        {
          "execArgs": [
            "pnpm",
            "update",
            "@biomejs/biome",
            "@jsii/spec",
            "@mrgrain/cdk-esbuild",
            "@types/node",
            "commit-and-tag-version",
            "constructs",
            "esbuild",
            "jsii-diff",
            "jsii-docgen",
            "jsii-pacmak",
            "jsii-rosetta",
            "jsii",
            "projen",
            "tsx",
            "typedoc",
            "typescript",
            "vitest",
            "@mrgrain/jsii-struct-builder",
            "case",
            "@vitest/coverage-v8"
          ]
        },
        {
          "exec": "pnpm exec projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "exec": "jsii -w --silence-warnings=reserved-word"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"pnpm exec projen\"."
}
